generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?
  name         String?
  image        String?
  createdAt    DateTime     @default(now())
  accounts     Account[]
  sessions     Session[]
  sites        Site[]
  readStatuses ReadStatus[]
  favorites    Favorite[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id          String    @id @default(cuid())
  userId      String
  name        String
  feedUrl     String
  siteUrl     String?
  faviconUrl  String?
  category    String?
  tags        String?
  isActive    Boolean   @default(true)
  lastFetched DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles    Article[]
}

model Article {
  id           String       @id @default(cuid())
  siteId       String
  title        String
  url          String
  publishedAt  DateTime
  thumbnailUrl String?
  excerpt      String?
  fetchedAt    DateTime     @default(now())
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  readStatuses ReadStatus[]
  favorites    Favorite[]

  @@unique([siteId, url])
}

model ReadStatus {
  id        String    @id @default(cuid())
  userId    String
  articleId String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
}
